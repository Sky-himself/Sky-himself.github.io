@unpublished{moradi2026vicinity,
  title     = {Vicinity-Aware Proactive Auto-Scaling for Containerized Edge Clusters},
  author    = {Moradi, Ehsan and Javadi, S. A.},
  note      = {Manuscript in preparation},
  year      = {2026},
  code      = {https://github.com/Sky-himself},
  abbr      = {Preprint},
  abstract  = {This paper proposes a proactive container-based auto-scaling approach for hierarchical edge computing environments. The architecture utilizes three primary layers: a central cloud server, cluster managers, and edge nodes. To efficiently handle workload demands, the system relies on a multi-tier escalation pipeline. Scaling decisions progress through Best-Effort Vertical (BEV) and Best-Effort Horizontal (BEH) scaling within a cluster, before escalating to Vicinity (BEVI) and Global (BEG) inter-cluster scaling. By establishing a vicinity of 1 to 3 geographically proximate clusters, the framework facilitates direct instance borrowing to minimize response time and optimize resource utilization.}
}
